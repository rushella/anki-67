@inherits LayoutComponentBase

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="main-content">
        <header class="top-row">
            <div class="container-fluid d-flex align-items-center justify-content-between gap-3 px-3 px-md-4">
                <span class="small text-body-secondary d-none d-sm-inline">Adaptive study workspace</span>
                <a class="btn btn-sm btn-outline-primary ms-auto"
                   href="https://learn.microsoft.com/aspnet/core/blazor/"
                   target="_blank"
                   rel="noopener noreferrer">Blazor docs</a>
            </div>
        </header>

        <article class="content px-3 px-md-4 py-4">
            <div class="container-fluid p-0">
                @Body
            </div>
        </article>
    </main>
</div>
