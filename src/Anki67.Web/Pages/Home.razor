@page "/"

<PageTitle>Dashboard | Anki67</PageTitle>

<div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
    <div>
        <span class="badge rounded-pill text-bg-primary mb-2">Anki67</span>
        <h1 class="display-6 fw-semibold mb-1">Your study dashboard</h1>
        <p class="text-body-secondary mb-0">A responsive Blazor WebAssembly starting point for every screen size.</p>
    </div>
    <div class="d-grid d-sm-flex gap-2">
        <a class="btn btn-primary btn-lg" href="anki">Open Anki</a>
        <a class="btn btn-outline-secondary btn-lg" href="anki">Edit cards</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Due today</p>
                <p class="display-6 fw-semibold mb-1">24</p>
                <span class="badge text-bg-warning">Ready to review</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <p class="small text-uppercase text-body-secondary fw-semibold mb-2">New cards</p>
                <p class="display-6 fw-semibold mb-1">8</p>
                <span class="badge text-bg-info">Available</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Current streak</p>
                <p class="display-6 fw-semibold mb-1">7 days</p>
                <span class="badge text-bg-success">On track</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <p class="small text-uppercase text-body-secondary fw-semibold mb-2">Retention</p>
                <p class="display-6 fw-semibold mb-1">91%</p>
                <div class="progress" role="progressbar" aria-label="Retention" aria-valuenow="91" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: 91%">91%</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <section class="card h-100 border-0 shadow-sm">
            <div class="card-header bg-body d-flex align-items-center justify-content-between py-3">
                <h2 class="h5 mb-0">Recent decks</h2>
                <button type="button" class="btn btn-sm btn-outline-primary">View all</button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Deck</th>
                            <th scope="col">Progress</th>
                            <th scope="col" class="text-end">Due</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="fw-semibold">Japanese vocabulary</span><br /><small class="text-body-secondary">Updated today</small></td>
                            <td><div class="progress" role="progressbar" aria-label="Japanese vocabulary progress" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width: 72%"></div></div></td>
                            <td class="text-end"><span class="badge text-bg-primary">12</span></td>
                        </tr>
                        <tr>
                            <td><span class="fw-semibold">Computer science</span><br /><small class="text-body-secondary">Updated yesterday</small></td>
                            <td><div class="progress" role="progressbar" aria-label="Computer science progress" aria-valuenow="48" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar bg-info" style="width: 48%"></div></div></td>
                            <td class="text-end"><span class="badge text-bg-primary">8</span></td>
                        </tr>
                        <tr>
                            <td><span class="fw-semibold">World capitals</span><br /><small class="text-body-secondary">Updated 3 days ago</small></td>
                            <td><div class="progress" role="progressbar" aria-label="World capitals progress" aria-valuenow="86" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar bg-success" style="width: 86%"></div></div></td>
                            <td class="text-end"><span class="badge text-bg-secondary">4</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="col-12 col-lg-4">
        <section class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5 card-title">Quick actions</h2>
                <p class="card-text text-body-secondary">Bootstrap components remain readable and touch-friendly on phones, tablets, and desktops.</p>
                <div class="list-group list-group-flush">
                    <button type="button" class="list-group-item list-group-item-action px-0">Create a deck</button>
                    <button type="button" class="list-group-item list-group-item-action px-0">Import cards</button>
                    <button type="button" class="list-group-item list-group-item-action px-0">Browse statistics</button>
                </div>
            </div>
        </section>
    </div>
</div>
